{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eva-app-dev",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": {
    "crons": [
      "0 7 * * *",
      "0 8 * * *",
      "0 9 * * *",
      "0 16 * * 0",
      "*/5 * * * *"
    ]
  }
}
